{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(uv run pytest *)",
      "WebFetch(domain:openlibrary.org)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:code.claude.com)",
      "Bash(gh pr *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.local)",
      "Read(./ml/.env)",
      "Read(./data/private/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase db reset --remote*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(pnpm exec supabase db reset --linked*)",
      "Bash(pnpm exec supabase db reset --remote*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
