{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(uv run pytest *)",
      "WebFetch(domain:openlibrary.org)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:code.claude.com)",
      "Bash(gh pr *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(python -c \"import json;json.load\\(open\\('.claude/settings.json'\\)\\)\")",
      "Bash(git commit -q -m 'chore\\(claude\\): ask before remote Supabase pushes and resets via pnpm exec *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.local)",
      "Read(./ml/.env)",
      "Read(./data/private/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase db reset --remote*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(pnpm exec supabase db reset --linked*)",
      "Bash(pnpm exec supabase db reset --remote*)"
    ]
  }
}
