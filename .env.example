# Copia in .env.local. Non committare mai i valori reali.
# Verifica i nomi delle chiavi Supabase nella documentazione durante F0.4.

# Supabase, lato client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase, solo lato server
SUPABASE_SECRET_KEY=

# Metadati, solo lato server
GOOGLE_BOOKS_API_KEY=
# Inserita nello User-Agent richiesto da Open Library
OPEN_LIBRARY_CONTACT=
