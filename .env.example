# Copia in .env.local. Non committare mai i valori reali.
# In locale i valori vengono da `pnpm exec supabase status`; per il remoto da
# Project Settings > API Keys. Le chiavi sono del tipo sb_publishable_… e sb_secret_….

# Supabase, lato client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase, solo lato server: mai nel browser né nell'app mobile
SUPABASE_SECRET_KEY=

# Metadati, solo lato server
GOOGLE_BOOKS_API_KEY=
# Inserita nello User-Agent richiesto da Open Library
OPEN_LIBRARY_CONTACT=
